{
  "name": "hrms-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "React UI for the HRMS Flask backend. The server stays authoritative for auth, permissions and business rules.",
  "scripts": {
    "dev": "vite",
