# ── Flask Core ────────────────────────────────────────────────────────
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
LOG_LEVEL=WARNING

# ── Phase 5 production cutover ────────────────────────────────────────
# PostgreSQL public is the production target. Keep the DuckDB file mounted
# read-only as the audit fallback until Phase 6 decommission.
APP_DB=postgres
APP_DB_SCHEMA=public
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/hrms
REDIS_URL=redis://HOST:6379/0
DB_FILE=/data/hrms.duckdb
# Never enable demo seeding in production; only for disposable validation DBs.
# HRMS_ALLOW_DEMO_SEED=1

# ── Attendance finalisation (FR-JOB-01) ───────────────────────────────
WEEKLY_OFF_PATTERN=Sat,Sun
ATTENDANCE_JOB_HOUR=2
ATTENDANCE_FULL_DAY_RATIO=1.0
ATTENDANCE_HALF_DAY_RATIO=0.5
ATTENDANCE_DEFAULT_SHIFT_HOURS=8

# ── Monitoring ────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Email (SMTP) ─────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@hrms.com
