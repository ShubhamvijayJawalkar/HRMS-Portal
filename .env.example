# ── Flask Core ────────────────────────────────────────────────────────
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
LOG_LEVEL=INFO
# The production target is the v2.0 schema. PostgreSQL is the only backend.
# APP_DB_SCHEMA=public
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/hrms
# REDIS_URL=redis://HOST:6379/0
# POSTGRES_DB=hrms
# POSTGRES_USER=hrms
# POSTGRES_PASSWORD=replace-with-a-local-password
# Local fresh-database demo only; never set this in production.
# HRMS_ALLOW_DEMO_SEED=1
# REQUIRED to anonymise an employee (FR-USR two-person erasure). At least 16
# characters, generated once and stored in the secret manager - changing it
# makes previous pseudonyms unrecognisable. Without it the anonymisation
# routes refuse to run instead of falling back to a weak mapping.
# ANONYMISATION_SALT=
# REQUIRED to use multi-factor authentication (FR-AUTH-11). A Fernet key that
# encrypts authenticator secrets at rest. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Stored in the secret manager. Changing it makes every enrolled employee's
# stored secret undecryptable and forces re-enrolment, so treat it as durable.
# Without it the MFA routes return 503 rather than storing secrets in the clear.
# MFA_ENCRYPTION_KEY=
# A second factor is compulsory for Admin / Super Admin / HR / Finance. The set
# lives in `mfa.MANDATORY_ROLES`; a test asserts it, so changing it is a code
# change, not a deployment one.
# Recovery is an audited Admin reset only — there are no recovery codes. The
# reset answers identically whether or not the target was enrolled, so it cannot
# be used to discover who is protected.

# ── Attendance finalisation (FR-JOB-01) ───────────────────────────────
# Default weekly-off pattern when an employee has no configured value.
WEEKLY_OFF_PATTERN=Sat,Sun
# Local scheduler hour (the job runs at 02:05).
ATTENDANCE_JOB_HOUR=2
# Status thresholds as fractions of the scheduled shift length.
ATTENDANCE_FULL_DAY_RATIO=1.0
ATTENDANCE_HALF_DAY_RATIO=0.5
ATTENDANCE_DEFAULT_SHIFT_HOURS=8

# ── Monitoring ────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Email (SMTP) ─────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@hrms.com
