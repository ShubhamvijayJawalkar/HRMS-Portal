# ── Flask Core ────────────────────────────────────────────────────────
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DB_FILE=hrms.duckdb
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
LOG_LEVEL=INFO

# ── Attendance finalisation (FR-JOB-01) ───────────────────────────────
# Default weekly-off pattern when an employee has no configured value.
WEEKLY_OFF_PATTERN=Sat,Sun
# Local scheduler hour (the job runs at 02:05).
ATTENDANCE_JOB_HOUR=2
# Status thresholds as fractions of the scheduled shift length.
ATTENDANCE_FULL_DAY_RATIO=1.0
ATTENDANCE_HALF_DAY_RATIO=0.5
ATTENDANCE_DEFAULT_SHIFT_HOURS=8

# ── Monitoring ────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Email (SMTP) ─────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@hrms.com
