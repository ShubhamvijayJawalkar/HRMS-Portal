# Python
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/
*.egg-info/

# Environment
.env

# Database
# DuckDB was decommissioned at Phase 6. Kept so a stray file from an old
# checkout is never committed by accident.
*.duckdb
*.duckdb.wal

# Generated / Build
uploads/*
# Database dumps (scripts/backup.py). Never commit these: a dump is a full copy of
# every employee's record, which is exactly the data the retention and encryption
# requirements exist to protect.
backups/
*.pptx
generate_ppt.py
ppt_screenshots/
HRMS_Deployment_Guide.docx
reports/

# React UI (docs/REACT_UI_MIGRATION.md)
node_modules/
# Build output. Vite fingerprints these filenames, so committing them would mean
# committing a hash that is no longer reproducible from the source. `npm run
# build` runs in CI and in the Docker build instead.
static/app/

# IDE / Config
.DS_Store
.opencode/

